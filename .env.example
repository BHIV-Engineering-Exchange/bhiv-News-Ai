# ---------------------------------------------------------
# NEWS AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ---------------------------------------------------------

# --- SERVER & SECURITY ---
JWT_SECRET_KEY=your_secure_random_secret_here
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development  # development | production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI & LLM SERVICES ---
ENABLE_OPENAI=0
OPENAI_API_KEY=sk-...
ENABLE_GROK=0
GROK_API_KEY=xai-...
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
BLACKHOLE_LLM_URL=https://d52770bec07e.ngrok-free.app
BLACKHOLE_LLM_MODEL=llama3.1

# --- EXTERNAL DATA APIs ---
SERPER_API_KEY=your_serper_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
X_USE_SNSCRAPE=false

# --- MONITORING & OBSERVABILITY ---
MONITOR_BACKEND_ROOT=http://localhost:8000/
MONITOR_API_HEALTH=http://localhost:8000/health
MONITOR_PIPELINE=http://localhost:8000/api/unified-news-workflow
MONITOR_PROCESSING=http://localhost:8000/api/fast-news-workflow
MONITOR_OUTPUT=http://localhost:8000/exports/weekly_report.json

# --- DATABASE & STORAGE ---
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=news_ai_db

# --- PIPELINE & AGENTS ---
UNIGURU_PROVIDER=stub  # local | stub
UNIGURU_API_KEY=your_uniguru_key
LANG_DOMINANCE_THRESHOLD=0.3
DEDUP_THRESHOLD=0.92
RAG_CACHE_MAX_ENTRIES=5000

# --- TTS & AVATAR AGENTS ---
TTS_PROVIDER=stub  # pyttsx3 | stub
AVATAR_PROVIDER=ffmpeg  # ffmpeg | heygen | did | sadtalker
HEYGEN_API_KEY=your_heygen_key
DID_API_KEY=your_did_key
SADTALKER_ROOT=./SadTalker
SADTALKER_PYTHON=python
