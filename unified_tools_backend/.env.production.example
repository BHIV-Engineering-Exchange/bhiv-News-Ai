# Insight Node - Production Environment Variables
# Copy this content to Render's "Environment Variables" section

# --- Core Configuration ---
# Render sets PORT automatically, but you can set NODE_ENV
NODE_ENV=production

# --- API Keys (Required for Full Functionality) ---
# Google Serper API (for search/vetting)
SERPER_API_KEY=your_serper_api_key_here

# YouTube Data API (for video search)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Twitter Bearer Token (for social search)
TWITTER_BEARER_TOKEN=your_twitter_token_here

# --- LLM Configuration (Optional/Fallback) ---
# Enable if you have keys
ENABLE_OPENAI=0
OPENAI_API_KEY=

ENABLE_GROK=0
GROK_API_KEY=

# --- External Services (Update if changed) ---
# Defaults to the Blackhole ngrok tunnel - update if you have a stable URL
OLLAMA_BASE_URL=https://249b3496e9d6.ngrok-free.app
BLACKHOLE_LLM_URL=https://d52770bec07e.ngrok-free.app
